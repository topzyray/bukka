generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHERS
}

enum UserRole {
  USER
  ADMIN
  VENDOR
  RIDER
  BUSINESS
  INVESTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DEACTIVATED
  RESTRICTED
  LOCKED
  DELETED
}

enum FileCategory {
  GENERAL
  BUSINESS_COVER
  BUSINESS_IMAGES
  USER_PROFILE_IMAGE
  EMAIL_TEMPLATE
  GALLERY
}

enum FileReferenceType {
  USER
  BUSINESS
  GENERAL
}

enum BusinessType {
  RESTAURANT
  FAST_FOOD
  FOOD_VENDOR
  BAR
  BAKERY
  LOUNGE
  STREET_EATRY
  CATERING
  GROCERY
  DELIVERY_SERVICE
  OTHER
}

enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SupportStatus {
  SUBMITTED
  PENDING
  RESOLVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
}

model File {
  id            Int               @id @default(autoincrement())
  referenceId   Int?
  category      FileCategory
  fileName      String
  fileType      String
  fullPath      String
  fileExtension String
  relativePath  String
  referenceType FileReferenceType
  createdById   Int?
  fileSize      Int?
  mimeType      String?
  isPublic      Boolean           @default(false)
  metadata      Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([referenceId, category])
  @@index([referenceType, referenceId])
  @@index([createdById])
  @@index([isPublic])
}

model Waitlist {
  id          Int      @id @default(autoincrement())
  name        String?
  email       String   @unique
  phoneNumber String?
  location    String?
  cuisine     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                      Int        @id @default(autoincrement())
  email                   String     @unique
  password                String
  role                    UserRole   @default(USER)
  firstName               String
  lastName                String
  username                String?    @unique
  gender                  Gender?
  phoneNumber             String?
  bio                     String?
  phoneCountryCode        String?
  phoneNumberConfirmed    Boolean?
  userStatus              UserStatus @default(ACTIVE)
  emailConfirmed          Boolean    @default(false)
  confirmationCode        String?
  confirmationCodeExpires DateTime?
  onboardingProgress      Int?       @default(0)
  passwordResetToken      String?
  passwordResetExpires    DateTime?
  passwordChangedAt       DateTime?
  lastLoginAt             DateTime?
  isDeleted               Boolean    @default(false)
  isOnboarded             Boolean    @default(false)
  deletedAt               DateTime?
  locationId              Int?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  userNotifications     UserNotification[]
  favorites             Favorite[]
  authSessions          UserSession[]
  reviews               Review[]
  ownedBusinesses       Business[]         @relation("BusinessOwner")
  recommendedBusinesses Business[]         @relation("BusinessRecommender")
  location              Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  Support               Support[]
  userOrders            Order[]            @relation("UserOrders")
  vendorOrders          Order[]            @relation("VendorOrders")
  riderOrders           Order[]            @relation("RiderOrders")
  recommendations       Recommendation[]

  @@index([email])
  @@index([username])
  @@index([locationId])
}

model Location {
  id        Int      @id @default(autoincrement())
  placeId   String?  @unique
  latitude  Float
  longitude Float
  address   String?
  street    String?
  city      String?
  state     String?
  country   String?
  zipCode   String?
  landmark  String?
  suburb    String?
  county    String?
  plusCode  String?
  cityId    String?
  stateId   String?
  countryId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businesses      Business[]
  users           User[]
  recommendations Recommendation[]

  @@index([placeId, id])
  @@index([latitude, longitude])
  @@index([city, state])
}

model BusinessCategory {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  slug            String           @unique
  createdBy       Int
  description     String?
  iconUrl         String?
  type            BusinessType
  businesses      Business[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recommendations Recommendation[]

  @@index([slug])
}

model Business {
  id             Int          @id @default(autoincrement())
  ownerId        Int?
  recommenderId  Int?
  name           String
  description    String?
  type           BusinessType @default(RESTAURANT)
  categoryId     Int
  slug           String
  phoneNumber    String?
  email          String?
  website        String?
  registrationNo String?
  cuisines       Json[]
  isVerified     Boolean      @default(false)
  isActive       Boolean      @default(false)
  isFeatured     Boolean      @default(false)
  featuredRank   Int?
  featuredStart  DateTime?
  featuredEnd    DateTime?
  openingHours   Json?
  socialLinks    Json?
  locationId     Int?
  averageRating  Float?       @default(0)
  reviewCount    Int?         @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  location    Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  category    BusinessCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  owner       User?             @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recommender User?             @relation("BusinessRecommender", fields: [recommenderId], references: [id], onDelete: SetNull)
  reviews     Review[]
  favorites   Favorite[]
  orders      Order[]
  menus       Menu[]
  services    Service[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([locationId])
  @@index([type])
}

model Recommendation {
  id             Int                  @id @default(autoincrement())
  name           String
  description    String?
  type           BusinessType         @default(RESTAURANT)
  categoryId     Int
  slug           String?
  phoneNumber    String?
  email          String?
  website        String?
  registrationNo String?
  cuisines       Json[]
  note           String?
  recommenderId  Int?
  status         RecommendationStatus @default(PENDING)
  locationId     Int?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  location    Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  category    BusinessCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recommender User?             @relation(fields: [recommenderId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([recommenderId])
  @@index([locationId])
}

