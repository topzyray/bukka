generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHERS
}

enum UserRole {
  USER
  ADMIN
  BUSINESS
  RIDER
  INVESTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DEACTIVATED
  RESTRICTED
  LOCKED
  DELETED
}

enum FileCategory {
  GENERAL
  BUSINESS_COVER
  USER_PROFILE_IMAGE
  EMAIL_TEMPLATE
}

enum FileReferenceType {
  USER
  BUSINESS
  GENERAL
}

model File {
  id            Int               @id @default(autoincrement())
  referenceId   Int?
  category      FileCategory
  fileName      String
  fileType      String
  fullPath      String
  fileExtension String
  relativePath  String
  referenceType FileReferenceType
  createdById   Int?
  fileSize      Int? 
  mimeType      String? 
  isPublic      Boolean           @default(false)
  metadata      Json? 
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([referenceId, category])
  @@index([referenceType, referenceId])
  @@index([createdById])
  @@index([isPublic])
}

model Waitlist {
  id          Int      @id @default(autoincrement())
  name        String?
  email       String   @unique
  phoneNumber String?
  location    String?
  cuisine     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                      Int                @id @default(autoincrement())
  email                   String             @unique
  password                String
  role                    UserRole           @default(USER)
  firstName               String
  lastName                String
  username                String?            @unique
  gender                  Gender?
  phoneNumber             String?
  bio                     String?
  phoneCountryCode        String?
  phoneNumberConfirmed    Boolean?
  userStatus              UserStatus         @default(ACTIVE)
  emailConfirmed          Boolean            @default(false)
  confirmationCode        String?
  confirmationCodeExpires DateTime?
  refreshToken            String?
  passwordResetToken      String?
  passwordResetExpires    DateTime?
  passwordChangedAt       DateTime?
  lastLoginAt             DateTime?
  isDeleted               Boolean            @default(false)
  isUpdated               Boolean            @default(false)
  deletedAt               DateTime?
  locationId              Int?
  userNotifications       UserNotification[]
  favorites               Favorite[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([email])
  @@index([username])
  @@index([locationId])
}

model Restaurant {
  id            Int        @id @default(autoincrement())
  googlePlaceId String     @unique
  name          String
  address       String
  latitude      Float
  longitude     Float
  rating        Float?
  phoneNumber   String?
  website       String?
  favorites     Favorite[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Favorite {
  id           Int      @id @default(autoincrement())
  userId       Int
  restaurantId Int
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([userId, restaurantId])
}

model UserNotification {
  id                   Int      @id @default(autoincrement())
  userId               Int
  title                String
  message              String
  notificationCategory String
  isRead               Boolean  @default(false)
  icon                 String?
  link                 String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationSettings {
  id         Int      @id @default(autoincrement())
  userId     Int
  userStatus String?
  settings   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}
