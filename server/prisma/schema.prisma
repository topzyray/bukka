generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHERS
}

enum UserRole {
  USER
  ADMIN
  VENDOR
  RIDER
  BUSINESS
  INVESTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DEACTIVATED
  RESTRICTED
  LOCKED
  DELETED
}

enum FileCategory {
  GENERAL
  BUSINESS_COVER
  BUSINESS_IMAGES
  USER_PROFILE_IMAGE
  EMAIL_TEMPLATE
  GALLERY
}

enum FileReferenceType {
  USER
  BUSINESS
  GENERAL
}

enum BusinessType {
  RESTAURANT
  FAST_FOOD
  FOOD_VENDOR
  BAR
  BAKERY
  LOUNGE
  STREET_EATRY
  CATERING
  GROCERY
  DELIVERY_SERVICE
  OTHER
}

enum SupportStatus {
  SUBMITTED
  PENDING
  RESOLVED
}

model File {
  id            Int               @id @default(autoincrement())
  referenceId   Int?
  category      FileCategory
  fileName      String
  fileType      String
  fullPath      String
  fileExtension String
  relativePath  String
  referenceType FileReferenceType
  createdById   Int?
  fileSize      Int?
  mimeType      String?
  isPublic      Boolean           @default(false)
  metadata      Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([referenceId, category])
  @@index([referenceType, referenceId])
  @@index([createdById])
  @@index([isPublic])
}

model Waitlist {
  id          Int      @id @default(autoincrement())
  name        String?
  email       String   @unique
  phoneNumber String?
  location    String?
  cuisine     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                      Int                @id @default(autoincrement())
  email                   String             @unique
  password                String
  role                    UserRole           @default(USER)
  firstName               String
  lastName                String
  username                String?            @unique
  gender                  Gender?
  phoneNumber             String?
  bio                     String?
  phoneCountryCode        String?
  phoneNumberConfirmed    Boolean?
  userStatus              UserStatus         @default(ACTIVE)
  emailConfirmed          Boolean            @default(false)
  confirmationCode        String?
  confirmationCodeExpires DateTime?
  onboardingProgress      Int?               @default(0)
  passwordResetToken      String?
  passwordResetExpires    DateTime?
  passwordChangedAt       DateTime?
  lastLoginAt             DateTime?
  isDeleted               Boolean            @default(false)
  isOnboarded             Boolean            @default(false)
  deletedAt               DateTime?
  locationId              Int?
  avatar                  Json?
  userNotifications       UserNotification[]
  favorites               Favorite[]
  authSessions            UserSession[]
  reviews                 Review[]
  business                Business[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  location                Location?          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  Support                 Support[]

  @@index([email])
  @@index([username])
  @@index([locationId])
}

model Business {
  id             Int               @id @default(autoincrement())
  ownerId        Int
  name           String
  description    String?
  type           BusinessType      @default(RESTAURANT)
  categoryId     Int
  slug           String
  phoneNumber    String?
  email          String?
  website        String?
  registrationNo String?
  cuisines       Json[]
  isVerified     Boolean           @default(false)
  isActive       Boolean           @default(false)
  rating         Float?            @default(0)
  totalReviews   Int?              @default(0)
  openingHours   Json?
  socialLinks    Json?
  locationId     Int?
  averageRating  Int?
  reviewCount    Int?
  location       Location?         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  category       BusinessCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  reviews        Review[]
  favorites      Favorite[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([ownerId])
  @@index([categoryId])
  @@index([locationId])
  @@index([type])
}

model BusinessCategory {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  slug        String       @unique
  createdBy   Int
  description String?
  iconUrl     String?
  type        BusinessType
  businesses  Business[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([slug])
}

model Review {
  id         Int      @id @default(autoincrement())
  userId     Int
  businessId Int
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
}

model Location {
  id         Int        @id @default(autoincrement())
  placeId    String?    @unique
  latitude   Float
  longitude  Float
  address    String?
  city       String?
  state      String?
  country    String?
  zipCode    String?
  landmark   String?
  plusCode   String?
  cityId     String?
  stateId    String?
  countryId  String?
  businesses Business[]
  users      User[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([placeId, id])
  @@index([latitude, longitude])
  @@index([city, state])
}

model Favorite {
  id         Int      @id @default(autoincrement())
  userId     Int
  businessId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}

model UserNotification {
  id                   Int      @id @default(autoincrement())
  userId               Int
  title                String
  message              String
  notificationCategory String
  isRead               Boolean  @default(false)
  icon                 String?
  link                 String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationSettings {
  id        Int      @id @default(autoincrement())
  userId    Int
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserPersonalization {
  id                    Int      @id @default(autoincrement())
  userId                Int      @unique
  preferredCuisines     String[]
  dietaryRestrictions   Json? // Should be array
  mealPreferences       Json? // Should be array
  preferredDeliveryTime String
  paymentPreference     Json
  allergies             String?  @db.Text // Optional free text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

model UserSession {
  id           Int      @id @default(autoincrement())
  userId       Int
  deviceId     String
  refreshToken String
  userAgent    String
  ipAddress    String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
}

model Support {
  id         Int           @id @default(autoincrement())
  ticketId   String        @unique
  name       String
  email      String
  subject    String
  message    String
  status     SupportStatus @default(SUBMITTED)
  assigneeId Int?
  assignee   User?         @relation(fields: [assigneeId], references: [id])
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([ticketId])
  @@index([status])
  @@index([assigneeId])
}
