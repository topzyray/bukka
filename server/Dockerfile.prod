# Builder
FROM node:22-slim AS builder
ARG PNPM_VERSION=10.24.0
WORKDIR /app

# system deps for native builds (Prisma/sharp)
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 build-essential git ca-certificates openssl && \
    rm -rf /var/lib/apt/lists/*

# pin & enable pnpm via corepack (reproducible)
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# copy manifests early for caching
COPY package.json pnpm-lock.yaml ./

# install all deps (dev + prod) in builder
# NOTE: --shamefully-hoist gives a flat node_modules layout that copies well into Docker.
RUN pnpm install --frozen-lockfile --shamefully-hoist

# copy source + prisma schema
COPY prisma ./prisma
COPY . .

# generate prisma client (use pnpm exec to ensure local binary runs)
RUN pnpm exec prisma generate

# build the Nest app
RUN pnpm build

# optional: prune dev dependencies to reduce final node_modules size
RUN pnpm prune --prod

# Production
FROM node:22-slim AS prod
WORKDIR /app

# copy runtime artifacts from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/src/UtilityLayer/Views/Templates ./dist/UtilityLayer/Views/Templates
COPY --from=builder /app/src/UtilityLayer/Views/Templates/Images ./dist/UtilityLayer/Views/Templates/Images

ENV NODE_ENV=production
ENV EMAIL_TEMPLATES_DIR=/app/dist/UtilityLayer/Views/Templates

EXPOSE 8000

CMD ["node", "dist/main"]






