# ---- Build Stage ----
FROM node:22-alpine AS builder
WORKDIR /app

RUN npm install -g pnpm

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY prisma ./prisma
RUN pnpm prisma generate --output ./prisma-client

COPY . .
RUN pnpm build

# ---- Production Stage ----
FROM node:22-alpine AS prod
WORKDIR /app

RUN npm install -g pnpm

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --prod --frozen-lockfile

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma-client ./node_modules/@prisma/client
COPY --from=builder /app/src/UtilityLayer/Views/Templates ./dist/UtilityLayer/Views/Templates
COPY --from=builder /app/src/UtilityLayer/Views/Templates/Images ./dist/UtilityLayer/Views/Templates/Images

ENV NODE_ENV=production
ENV EMAIL_TEMPLATES_DIR=/app/dist/UtilityLayer/Views/Templates

EXPOSE 8000
CMD ["node", "dist/main"]
