# ---- Build Stage ----
FROM node:22-alpine AS builder
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache libc6-compat python3 make g++ git

# Install pnpm
RUN npm install -g pnpm

# Copy package manifests and install dependencies (dev + prod)
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Copy source code and Prisma schema
COPY prisma ./prisma
COPY . .

# Build NestJS app
RUN pnpm build

# ---- Production Stage ----
FROM node:22-alpine AS prod
WORKDIR /app

# Runtime dependencies (for Prisma and Sharp)
RUN apk add --no-cache libc6-compat python3 make g++ git

# Install pnpm
RUN npm install -g pnpm

# Copy package files and install prod dependencies (dev needed for Prisma client generation)
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --prod --frozen-lockfile

# Copy Prisma schema and source code
COPY prisma ./prisma
COPY . .

# Generate Prisma client in prod
RUN npx prisma generate

# Build NestJS in prod (if needed)
RUN pnpm build

# Optional: Copy templates if you are not bundling them via nest-cli.json
COPY src/UtilityLayer/Views/Templates ./dist/UtilityLayer/Views/Templates

# Environment variables
ENV NODE_ENV=production
ENV EMAIL_TEMPLATES_DIR=/app/dist/UtilityLayer/Views/Templates

# Expose port
EXPOSE 8000

# Start the app
CMD ["node", "dist/main"]
